{#
 luci-theme-outline: login page
 Copyright 2025 eamonxg <eamonxiong@gmail.com>
 Licensed to the public under the Apache License 2.0.
-#}

{%
	import { access } from 'fs';
	import { cursor } from 'uci';
	import { getspnam } from 'luci.core';

	const boardinfo = ubus.call('system', 'board') ?? {};
	// Same rule as header.ut: a branding slot overrides the theme's logo.
	const branding = cursor().get_all('outline', 'branding') ?? {};
	const brand_logo = branding.logo;
	const logo_url = (brand_logo == 'openwrt' && access('/www/luci-static/bootstrap/logo.svg'))
		? '/luci-static/bootstrap/logo.svg'
		: (brand_logo && match(brand_logo, /^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$/) && access(`/www/luci-static/outline-brand/${brand_logo}`))
		? `/luci-static/outline-brand/${brand_logo}?v=${match(branding.rev ?? '', /^[0-9]+$/) ? branding.rev : '0'}`
		: `${media}/images/logo.png`;
	const hostname = entityencode(striptags(boardinfo?.hostname ?? 'OpenWrt'));
	// A router without a root password (fresh or reset) logs in with an empty
	// field: say so in it, and offer the arrow at once.
	const pw_unset = (getspnam(duser ?? 'root')?.pwdp == '');
-%}
{% include('header', { blank_page: true }) %}
{#
 One centred column (after Family's sign-in), whose states swap inside it:
 password → signed in. The server renders the password state, so the
 page works as a plain form POST without JS; the script below turns it
 into a fetch() of the same POST (a wrong password shakes the field in
 place, no reload) and hands off to LuCI with a real navigation under a
 view transition.
-#}
<script>document.documentElement.classList.add('auth-js');</script>
<main class="auth-page">
	<div class="auth" id="auth" role="dialog" aria-modal="true" aria-labelledby="auth-title">
		<div class="auth-measure" id="auth-measure">
			<form class="auth-view{% if (pw_unset): %} has-value{% endif %}" id="auth-form" method="post" data-state="form"{% if (pw_unset): %} data-no-password=""{% endif %}
				data-invalid="{{ entityencode(_('Invalid username and/or password! Please try again.'), true) }}"
				data-unreachable="{{ entityencode(_('Device unreachable!'), true) }}"
				data-failed="{{ entityencode(_('Connection attempt failed'), true) }}">
				{#- From the site root the page is born "Redirecting": decided
				    before anything inside is parsed, so nothing first renders
				    as the form and cross-fades back. -#}
				<script>try { if (sessionStorage.getItem('outline.from-root')) document.currentScript.parentNode.setAttribute('data-state', 'redirecting'); } catch (e) {}</script>
				{#- Family's sign-in: the logo, a welcome and what is being
				    managed; the field with its send button; a footnote. -#}
				<div class="auth-head">
					{#- The logo wears the state too: an arrow while redirecting, a
					    tick once signed in (login.css). -#}
					<span class="auth-mark">
						<img src="{{ logo_url }}" alt="" width="40" height="40">
						<svg class="auth-badge" data-status="redirecting" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
						<svg class="auth-badge" data-status="connected" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
					</span>
					<h1 class="auth-title" id="auth-title">Welcome to {{ hostname }}</h1>
					{#- The line under the title carries the page's state: what is
					    being managed, "Redirecting" (from the site root), "Loading
					    view…" (signed in), cross-faded (login.css). -#}
					<p class="auth-sub" role="status">
						<span data-status="form">Log in to manage {{ version.distname }} {{ version.distversion }}.</span>
						<span class="auth-shimmer" data-status="redirecting">Redirecting</span>
						<span class="auth-shimmer" data-status="connected">{{ _('Loading view…') }}</span>
					</p>
				</div>

				{#- Everything under the title only belongs to the form state: it
				    opens and closes as one (height and fade, setState). -#}
				<div class="auth-body"><div class="auth-body-inner">
					<input class="auth-user" type="text" name="luci_username" value="{{ entityencode(duser ?? 'root', true) }}" autocomplete="username" tabindex="-1" aria-hidden="true">

					<div class="auth-field{% if (fuser): %} is-invalid{% endif %}">
						<input class="auth-input" id="luci_password" type="password" name="luci_password"
							placeholder="{{ pw_unset ? _('No password set!') : _('Password') }}" autocomplete="current-password" autofocus
							aria-label="{{ _('Password') }}" aria-describedby="auth-error"{% if (fuser): %} aria-invalid="true"{% endif %}>
						<button type="button" class="auth-icon-btn" id="auth-eye" aria-label="{{ _('Reveal/hide password') }}" aria-pressed="false">
							<span class="auth-swap">
								<svg class="is-on" data-icon="eye" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg>
								<svg data-icon="eye-off" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"/><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"/><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"/><path d="m2 2 20 20"/></svg>
							</span>
						</button>
						<button type="submit" class="auth-submit" id="auth-submit" aria-label="{{ _('Log in') }}">
							<span class="auth-swap">
								<svg class="is-on" data-icon="arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
								<svg data-icon="spinner" class="auth-spin" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
							</span>
						</button>
					</div>


					{#- Opens under the field (height and fade, login.css). -#}
					<div class="auth-error-wrap{% if (fuser): %} is-shown{% endif %}">
						<div><p class="auth-error" id="auth-error" role="alert">{{ _('Invalid username and/or password! Please try again.') }}</p></div>
					</div>

					{#- Family's footnote: one line for the empty field, another
					    once something is typed, cross-faded. -#}
					<p class="auth-note">
						{% if (pw_unset): %}
						<span>No password is set yet: continue, then set one under System › Administration.</span>
						{% else %}
						<span class="auth-note-empty">Use the password of the router's root account.</span>
						<span class="auth-note-value">You'll stay signed in until you log out.</span>
						{% endif %}
					</p>
				</div></div>
			</form>
		</div>
	</div>




	{#- Family's footer: the links, set apart by dots. -#}
	<footer class="login-footer">
		<ul class="login-footer-links">
			<li><a href="https://openwrt.org/" target="_blank" rel="noreferrer">{{ version.distname }}</a></li>
			<li><a href="https://github.com/openwrt/luci" target="_blank" rel="noreferrer">LuCI</a></li>
			<li><a href="https://github.com/tickcount/luci-theme-outline" target="_blank" rel="noreferrer">Outline Theme</a></li>
			<li><a href="https://aemeath.eu/" target="_blank" rel="noreferrer">aemeath.eu</a></li>
		</ul>
	</footer>
</main>

<script>
(function () {
	'use strict';

	/* The shimmer's phase follows the clock, as on the site root, so
	   "Redirecting" carries on across the page change instead of restarting. */
	document.querySelectorAll('.auth-shimmer').forEach(function (el) {
		(el.getAnimations ? el.getAnimations() : []).forEach(function (a) {
			if (a.animationName === 'auth-shimmer')
				a.currentTime = (performance.timeOrigin + performance.now()) % 1800;
		});
	});

	/* The site root (/www/outline.html) is static: it draws this card from
	   what the theme's pages leave here (footer.ut does the same). */
	try {
		var html = document.documentElement;
		var css = document.querySelector('link[href*="/login.css"]');
		var palette = document.getElementById('outline-appearance');
		localStorage.setItem('outline.bg', getComputedStyle(html).backgroundColor);
		localStorage.setItem('outline.dark', html.getAttribute('data-darkmode') || 'false');
		localStorage.setItem('outline.host', {{ replace(sprintf('%J', striptags(boardinfo?.hostname ?? 'OpenWrt')), '<', '\\u003c') }});
		localStorage.setItem('outline.logo', {{ replace(sprintf('%J', logo_url), '<', '\\u003c') }});
		if (css) localStorage.setItem('outline.css', css.getAttribute('href'));
		if (palette) localStorage.setItem('outline.appearance', palette.textContent);
		/* The column and the footer, so the root draws the very same page. */
		var q = function (sel) { var e = document.querySelector(sel); return e ? e.textContent.trim() : ''; };
		localStorage.setItem('outline.auth', JSON.stringify({
			title: q('#auth-title'),
			redirecting: q('.auth-sub [data-status="redirecting"]'), links: Array.prototype.map.call(document.querySelectorAll('.login-footer-links a'), function (a) { return [a.textContent, a.getAttribute('href')]; })
		}));
		var bd = document.getElementById('outline-backdrop');
		if (bd && html.hasAttribute('data-backdrop')) localStorage.setItem('outline.backdrop', bd.outerHTML);
		else localStorage.removeItem('outline.backdrop');
	} catch (e) {}

	var auth = document.getElementById('auth');
	var measure = document.getElementById('auth-measure');
	var form = document.getElementById('auth-form');
	if (!auth || !form || !window.fetch) {
		auth && auth.classList.add('is-on');
		return;
	}

	var field = form.querySelector('.auth-field');
	var pw = document.getElementById('luci_password');
	var eye = document.getElementById('auth-eye');
	var submit = document.getElementById('auth-submit');
	var errorEl = document.getElementById('auth-error');
	var errorWrap = errorEl.closest('.auth-error-wrap');

	/* The page's states (form[data-state]): form, redirecting, connected.
	   Outside the form the body is taken out of the flow and fades while
	   its box closes; back to the form it opens and fades in -- the box's
	   height on Family's container curve (expo-out, 600 ms), the fades on
	   their spring (login.css). The column re-centres as it goes. */
	var body = form.querySelector('.auth-body');
	function setState(state) {
		var from = body.getBoundingClientRect().height;
		form.setAttribute('data-state', state);
		var to = body.getBoundingClientRect().height;
		if (from === to || reduced()) return;
		/* Only the box's height moves (it re-centres the column); what is
		   in it stands in place and fades, never clipped. */
		body.animate([{ height: from + 'px' }, { height: to + 'px' }],
			{ duration: 600, easing: 'cubic-bezier(.19, 1, .22, 1)' });
	}

	/* Family's error: the wrapper's height eases between 0 and the
	   message's (expo-out, 400 ms) both ways; the message fades in CSS. */
	function setError(on) {
		var from = errorWrap.getBoundingClientRect().height;
		errorWrap.classList.toggle('is-shown', on);
		var to = errorWrap.getBoundingClientRect().height;
		if (from !== to && !reduced())
			errorWrap.animate([{ height: from + 'px' }, { height: to + 'px' }],
				{ duration: 400, easing: 'cubic-bezier(.19, 1, .22, 1)' });
	}
	/* An empty field is sent too: the dispatcher decides (403 when a password
	   is set, a session when none is). */
	var noPassword = form.hasAttribute('data-no-password');

	/* Family's timing: views cross-fade (opacity only) over 500 ms on an
	   expo-out curve; the column's height follows its content (login.css). */
	var VIEW = { duration: 500, easing: 'cubic-bezier(.19, 1, .22, 1)' };
	var reduced = function () {
		return matchMedia('(prefers-reduced-motion: reduce)').matches;
	};
	var dur = function (ms) { return reduced() ? 0 : ms; };

	/* useMeasure: the card's size follows the measured content, the CSS
	   transition animates every change. */
	if (window.ResizeObserver) {
		new ResizeObserver(function () {
			auth.style.setProperty('--w', Math.ceil(measure.offsetWidth) + 'px');
			auth.style.setProperty('--h', Math.ceil(measure.offsetHeight) + 'px');
		}).observe(measure);
	}

	/* Keep the card centred on what is visible when a keyboard opens (iOS
	   does not resize the layout viewport). */
	if (window.visualViewport) {
		var vv = window.visualViewport;
		var centre = function () {
			/* Pinch-zoomed, the visual viewport pans over the page: the card
			   stays put on the page (centred in the layout viewport) instead
			   of following the pan and sliding off its side. */
			var zoomed = vv.scale > 1.01;
			auth.style.setProperty('--vv-top', (zoomed ? 0 : vv.offsetTop) + 'px');
			auth.style.setProperty('--vv-h', (zoomed ? window.innerHeight : vv.height) + 'px');
		};
		vv.addEventListener('resize', centre);
		vv.addEventListener('scroll', centre);
		centre();
	}


	function swapIcon(btn, name) {
		btn.querySelectorAll('[data-icon]').forEach(function (s) {
			s.classList.toggle('is-on', s.getAttribute('data-icon') === name);
		});
	}

	function reject(message) {
		field.classList.add('is-invalid');
		pw.setAttribute('aria-invalid', 'true');
		pw.readOnly = false;
		swapIcon(submit, 'arrow');
		if (message) {
			errorEl.textContent = message;
			setError(true);
		}
		if (!reduced())
			/* Family's shake: 4px, -4px, 4px and back, 220 ms linear. */
			field.animate([
				{ translate: '0' }, { translate: '4px' }, { translate: '-4px' }, { translate: '4px' }, { translate: '0' }
			], { duration: 220, easing: 'linear' });
		/* As Family's: the text stays, the ring and the message say what
		   is wrong; typing clears them. */
		pw.focus();
	}

	pw.addEventListener('input', function () {
		form.classList.toggle('has-value', noPassword || pw.value.length > 0);
		if (field.classList.contains('is-invalid')) {
			field.classList.remove('is-invalid');
			pw.removeAttribute('aria-invalid');
			setError(false);
		}
	});

	/* The input is one line tall (login.css); the rest of the pill still
	   puts the caret in it. */
	field.addEventListener('mousedown', function (ev) {
		if (ev.target === field) {
			ev.preventDefault();
			pw.focus();
		}
	});

	eye.addEventListener('click', function () {
		var reveal = pw.type === 'password';
		pw.type = reveal ? 'text' : 'password';
		eye.setAttribute('aria-pressed', String(reveal));
		swapIcon(eye, reveal ? 'eye-off' : 'eye');
		pw.focus();
	});

	/* The dispatcher's own login, by fetch: a 302 (opaque under
	   redirect: 'manual') sets the session cookie; a wrong password answers
	   403 + X-LuCI-Login-Required. */
	form.addEventListener('submit', function (ev) {
		ev.preventDefault();
		if (pw.readOnly) return;

		pw.readOnly = true;
		swapIcon(submit, 'spinner');

		var url = location.href.split('#')[0];
		fetch(url, {
			method: 'POST',
			body: new URLSearchParams(new FormData(form)),
			redirect: 'manual',
			credentials: 'same-origin',
			cache: 'no-store'
		}).then(function (res) {
			if (res.type === 'opaqueredirect' || (res.ok && !res.headers.get('X-LuCI-Login-Required')))
				connected(url);
			else if (res.status === 403 && res.headers.get('X-LuCI-Login-Required'))
				reject(form.getAttribute('data-invalid'));
			else
				reject(form.getAttribute('data-failed'));
		}, function () {
			reject(form.getAttribute('data-unreachable'));
		});
	});

	/* Signed in: the card turns to its last state, then a real navigation
	   loads LuCI on the same URL; the card leaves over it as a view
	   transition (login.css), a plain load where that is unsupported. */
	function connected(url) {
		auth.setAttribute('aria-busy', 'true');
		pw.blur();
		if (window.getSelection) getSelection().removeAllRanges();
		setState('connected');
		setTimeout(function () { location.replace(url); }, dur(450));
	}

	/* Boot: the card opens on its loading state and turns into the form once
	   fonts are in. From the site root, or after a no-JS failed login
	   (fuser), the form shows at once. */
	/* The column's own parts fade in (login.css); the card itself does not. */
	function open() {
		auth.classList.add('is-on');
	}

	/* Arriving from the site root (/www/outline.html), whose "Redirecting"
	   card was the wait: no loading state of our own. */
	var fromRoot = null;
	try {
		fromRoot = sessionStorage.getItem('outline.from-root');
		sessionStorage.removeItem('outline.from-root');
	} catch (e) {}

	if (fromRoot) {
		/* Pick up exactly where the root's page left off -- the same
		   column saying "Redirecting" -- then the form opens under it. The
		   root started the entrance (it stored when): carry on from there,
		   so a slow LuCI never replays it and a fast one never cuts it. */
		var since = Date.now() - (+fromRoot || 0);
		if (since >= 0) auth.style.setProperty('--auth-skip', -Math.min(since, 1000) + 'ms');
		form.setAttribute('data-state', 'redirecting');
		auth.classList.add('is-on');
		(document.fonts ? document.fonts.ready : Promise.resolve()).then(function () {
			setTimeout(function () {
				setState('form');
				pw.focus({ preventScroll: true });
			}, dur(300));
		});
		return;
	}

	if (field.classList.contains('is-invalid')) {
		open();
		pw.focus();
		return;
	}

	/* No loading state: the column rises into place (login.css) once the
	   fonts are in, so it never re-flows under the eye. */
	(document.fonts ? document.fonts.ready : Promise.resolve()).then(function () {
		open();
		pw.focus({ preventScroll: true });
	});
})();
</script>

{% include('footer', { blank_page: true }) %}
