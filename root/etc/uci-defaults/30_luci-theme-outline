#!/bin/sh

# A fresh install (including a reinstall after removal, which leaves
# luci.themes.Outline behind) registers and activates the theme. Upgrades
# keep whatever theme the user picked.
if [ "$PKG_UPGRADE" != 1 ]; then
	uci batch <<-EOF
		set luci.themes.Outline=/luci-static/outline
		set luci.main.mediaurlbase=/luci-static/outline
		commit luci
	EOF
fi

# The theme's settings (System › System › Language and Style). Absent options mean the stock look, so
# only the sections are created; nothing is overwritten on upgrade.
[ -f /etc/config/outline ] || touch /etc/config/outline
for s in appearance:appearance light:theme dark:theme branding:branding updates:updates; do
	uci -q get "outline.${s%%:*}" >/dev/null || uci -q set "outline.${s%%:*}=${s#*:}"
done
uci -q commit outline

# Automatic updates are on unless someone turned them off (the option is only
# unset when nobody ever chose): a weekly check at a time picked once at
# random, 03:00-05:59 router time, as the Outline section's switch does, so
# routers do not all ask GitHub at the same moment.
if [ -z "$(uci -q get outline.updates.auto)" ]; then
	if [ -z "$(uci -q get outline.updates.minute)" ]; then
		read -r min hour wday mday <<-EOF
			$(awk 'BEGIN { srand(); print int(rand() * 60), 3 + int(rand() * 3), int(rand() * 7), 1 + int(rand() * 28) }')
		EOF
		uci -q set outline.updates.minute="$min"
		uci -q set outline.updates.hour="$hour"
		uci -q set outline.updates.weekday="$wday"
		uci -q set outline.updates.monthday="$mday"
	fi
	uci -q set outline.updates.auto=1
	uci -q set outline.updates.interval=weekly
	uci -q commit outline
	cmd=/usr/libexec/outline/job
	tab=/etc/crontabs/root
	{
		[ -f "$tab" ] && grep -v -F "$cmd auto" "$tab"
		echo "$(uci -q get outline.updates.minute) $(uci -q get outline.updates.hour) * * $(uci -q get outline.updates.weekday) $cmd auto >/dev/null 2>&1"
	} >"$tab.outline" && mv "$tab.outline" "$tab"
	/etc/init.d/cron enable >/dev/null 2>&1
	/etc/init.d/cron restart >/dev/null 2>&1
fi

# The site root (/) is the theme's "Redirecting" card (/www/outline.html)
# while Outline is the active theme, luci-base's index.html otherwise;
# /etc/init.d/luci-theme-outline keeps it so on every theme switch.
/usr/libexec/outline/root-page

# Brand images uploaded on the Appearance page live outside the package's own
# directory so a reinstall keeps them.
[ -d /www/luci-static/outline-brand ] || mkdir -p /www/luci-static/outline-brand

# luci-app-outline-theme (pre-release, never packaged) kept the generated
# stylesheet here; the theme assembles it from the stored tokens now. Its
# update options become the theme's single `repo` (only when customised).
rm -rf /etc/outline
r="$(uci -q get outline.updates.theme_repo)"
[ -n "$r" ] && [ "$r" != tickcount/luci-theme-outline ] && uci -q set outline.updates.repo="$r"
uci -q delete outline.updates.theme_repo
uci -q delete outline.updates.app_repo
uci -q commit outline

exit 0
